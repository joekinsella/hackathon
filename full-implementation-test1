import json
import requests
import ollama

ORCHESTRATOR_PROMPT = """ You are a multi agent system Architect.
Given a USER TASK and a SECURITY RISK LEVEL (1-10), design a multi-agent system.

STEP 1: Choose a topology based strictly on security requirements:
- "Linear": Highest Security (8-10). Strict sequence of isolated stages to minimize attack surface and data leaks.
- "Star": Medium Security (4-7). A central coordinator delegates to isolated specialists and inspects messages.
- "Complete": Lowest Security (1-3). Fully interconnected mesh allowing unrestricted communication among all agents.

STEP 2: Define the agents.
Use 3 to 6 agents with descriptive names to quickly identify their roles and responsibilities.
Note, the agents must have actual names based on jobs, not just "agent 1, agent 2...", do not include the word agent in the name

TOPOLOGY RULES:

Linear: agents form one line. Each agent sends to exactly the next and previous agent.
The last agent has [second to last agent]. No agent has more than two target. The first and last agent have exactly one target

Star: ONE hub agent connects to every other agent. Spokes talk ONLY to the hub,
never to each other. The hub lists all spokes; each spoke lists only the hub.

Complete: all agents are connected to each other. Each agent lists all other agents as its targets.

The examples above only show the SHAPE. Use your own agent names that fit the task.
STEP 3: Define the adjacency list based on the chosen topology.
Example of linear:
{
  "AgentA": ["AgentB"],
  "AgentB": ["AgentA", "AgentC"],
  "AgentC": ["AgentB"]
}

Example of star:
{
  "HubAgent": ["AgentA", "AgentB", "AgentC"],
  "AgentA": ["HubAgent"],
  "AgentB": ["HubAgent"],
  "AgentC": ["HubAgent"]
}

Example of complete:
{
  "AgentA": ["AgentB", "AgentC"],
  "AgentB": ["AgentA", "AgentC"],
  "AgentC": ["AgentA", "AgentB"]
}

STEP 4: Write a role description for each agent: what it does, what input it expects,
and what it must pass on. For high security risk, include an agent whose job is to
inspect or validate other agents' output.

Return ONLY a JSON object in exactly this format:
{
  "topology_type": "Linear" or "Complete" or "Star",
  "adjacency_list" : {"<Agent>": ["<TargetAgent>", ...]},
  "reasoning": "<one or two sentences>",
  "agent_roles": {"<Agent>": "<role and instructions>"}
}
"""

print("FILE STARTED", flush=True)

#enforce llm to respond with json so that can process by json keys
def prompt_llm(system_prompt: str, user_prompt: str) -> dict:
    url = "http://localhost:11434/api/chat"
    payload = {
        "model": "llama3.2",
        "messages": [
            #system pr0mpt injects in header
            {"role": "system", "content": system_prompt},
            #user_pr0mpt reads similar to human entry
            {"role": "user", "content": user_prompt}
        ],
        "format": "json",
        "stream": False
    }
    try:
        # Added timeout=60 so it doesn't hang forever if Ollama is unresponsive
        response = requests.post(url, json=payload, timeout=60).json()
        return json.loads(response["message"]["content"])
    except requests.exceptions.ConnectionError:
        print("\n ERROR: Could not connect to Ollama. Make sure Ollama is running ('ollama serve')!")
        raise
    except Exception as e:
        print(f"\n ERROR parsing LLM response: {e}")
        return {"public_message": "Error processing task.", "private_memory": "Failed step."}


class Agent:
    def __init__(self, agent_id: str, role_description: str):
        self.agent_id = agent_id
        self.role_description = role_description
        self.memory_log = []
        self.output = ""
       

   
    #steps the agent. LLM is provided memory log and incoming message from other agent
    #after llm call, appends that rounds' context to memory log. Returns output for peer agent.
    def update_state(self, incoming_message: list) -> str:
        if self.memory_log:
            #format bulleted list 
            memory_context = "\n".join([f"• {m}" for m in self.memory_log])
        else:
            #**might not be necessary**
            memory_context = "Initial memory state is empty."

        system_prompt = f"""
        You are {self.agent_id}, acting as a {self.role_description}.
        You must respond using a JSON object containing exactly two keys:
        "public_message": Your public message to pass to peer agents.
        "private_memory": A concise note for yourself about what happened THIS round (under 100 words).
        """

        user_prompt = f"""
        Accumulated Private Memory (All Past Rounds):
        {memory_context}

        Incoming Message from Peer Agent:
        {incoming_message}
        """

        #Get JSON output from LLM
        data = prompt_llm(system_prompt, user_prompt)

        #Append the new note to memory list
        new_note = data.get("private_memory", "")
        if new_note:
            self.memory_log.append(new_note)

        peer_message = data.get("public_message", "")
        print(f"{self.agent_id} Saved Memory Note: '{new_note}'")
        print(f"{self.agent_id} Generated Public Message: '{peer_message}'")

        #return public message to be passed to neighbor agent(s)
        return peer_message


def get_agent_job_summaries(task: str, security_score: str = "5") -> tuple:
    # CHANGED: topology is computed in code so the model can't ignore the thresholds
    level = int(security_score)
    topology = "Linear" if level >= 8 else "Star" if level >= 4 else "Complete"

    prompt = (f"Design a multi-agent system for task: '{task}' "
              f"with Security Level: {level}/10. "
              f"REQUIRED TOPOLOGY: {topology}. Do not choose a different one.")

    response = ollama.chat(
        model="llama3.2",
        messages=[
            {"role": "system", "content": ORCHESTRATOR_PROMPT},
            {"role": "user", "content": prompt},
        ],
        format="json",
    )

    # CHANGED: no try/except for now; a crash shows you what went wrong
    data = json.loads(response["message"]["content"])
    print("Orchestrator output:", json.dumps(data, indent=2))   # handy while debugging

    adjacency = data["adjacency_list"]
    roles = data["agent_roles"]
    names = list(adjacency)

    # NEW: entry/output agents aren't in the JSON, so derive them
    if data["topology_type"] == "Star":
        entry = max(adjacency, key=lambda a: len(adjacency[a]))   # the hub
        output = entry
    else:                                                          # Linear or Complete
        entry = names[0]
        output = names[-1]

    spec = {
        "adjacency": adjacency,
        "entry_agent": entry,
        "output_agent": output,
    }
    agents = {name: Agent(name, desc) for name, desc in roles.items()}

    return spec, agents, task



#runner code
def run_system(spec, agents, task):
    #spec is a dictionary with the format {"adjacency": adj_list{}, "roles": roles_desc{}, "entry_agent": Agent agnt1, "output_agent": Agent agnt2}
    adjacency = spec["adjacency"]
    inbox = {agent_id: [] for agent_id in agents}        # creates one mailbox[] per agent
    inbox[spec["entry_agent"]].append(task)    # user defined task goes to the entry agent
    last_output = None

    for round_num in range(len(agents)):
        print(f"\n--- round {round_num} --- inboxes: { {a: len(m) for a, m in inbox.items()} }")
        outgoing = []                                    # held until everyone has run

        for agent_id, agent in agents.items():
            if not inbox[agent_id]:                      # no mail -> skip
                continue

            messages = inbox[agent_id]
            inbox[agent_id] = []                         # empty the mailbox

            output = agent.update_state(messages)      #call update state with messages in agents inbox

            if agent_id == spec["output_agent"]:
                last_output = output
                

            for target in adjacency[agent_id]:           # update outgoing with tuple containing target_agent, message
                outgoing.append((target, output))
            

        for target, message in outgoing:                 # deliver from outgoing to inboxes of recieving agents
            inbox[target].append(message)

        if not any(inbox.values()):                      # nobody has mail -> done
            break

    return last_output


# ---------- 4. Main ----------
if __name__ == "__main__":
    print("Starting pipeline!!", flush=True)
    task = input("Task: ")
    security = input("Security level (1-10): ").strip()

    spec, agents, task = get_agent_job_summaries(task, security)   # CHANGED: three return values
    print("\nAdjacency list:", spec["adjacency"])
    print("Entry:", spec["entry_agent"], "| Output:", spec["output_agent"])

    final = run_system(spec, agents, task)
    print("\nFINAL ANSWER:", final)